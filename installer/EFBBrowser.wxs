<!--
  MSI installer for the EFB Web Browser (MSFS 2024): built by installer\build.ps1 with WiX 7.

  Like EFBBrowser.iss it only installs the companion .exe (the EFB package is embedded in it), then runs
  the companion with its install flag to deploy the package and register the companion in EXE.xml.
  Uninstalling runs it with its uninstall flag first. Per-user: no admin rights needed.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="EFB Web Browser for MSFS 2024"
           Manufacturer="ButterSim"
           Version="$(Version)"
           UpgradeCode="3F0C1B7E-5D2A-4C8B-9E61-7A4D2B9C0E15"
           Scope="perUser"
           Compressed="yes">
    <SummaryInformation Description="EFB Web Browser for MSFS 2024" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of the EFB Web Browser is already installed." />
    <!-- Stored, not compressed: compressed payloads score as "obfuscated" with some AV heuristics. -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="none" />

    <!-- The install step needs the sim's UserCfg.opt (Store or Steam): check up front, with a clear message. -->
    <Property Id="MSFS_STORE">
      <DirectorySearch Id="StoreCfgDir" Depth="0"
                       Path="[LocalAppDataFolder]Packages\Microsoft.Limitless_8wekyb3d8bbwe\LocalCache">
        <FileSearch Name="UserCfg.opt" />
      </DirectorySearch>
    </Property>
    <Property Id="MSFS_STEAM">
      <DirectorySearch Id="SteamCfgDir" Depth="0" Path="[AppDataFolder]Microsoft Flight Simulator 2024">
        <FileSearch Name="UserCfg.opt" />
      </DirectorySearch>
    </Property>
    <!-- Store data moved to another drive: the package folder is a junction into a protected WpSystem
         folder that the search above cannot read. The install step then asks for administrator rights. -->
    <Property Id="MSFS_STORE_PKG">
      <DirectorySearch Id="StorePkgDir" Depth="0" Path="[LocalAppDataFolder]Packages\Microsoft.Limitless_8wekyb3d8bbwe" />
    </Property>
    <Launch Condition="Installed OR MSFS_STORE OR MSFS_STORE_PKG OR MSFS_STEAM"
            Message="Microsoft Flight Simulator 2024 was not found for this Windows user. Start the sim once (until its main menu), quit it, then run this installer again." />

    <!-- Welcome, Install, Finish: like WixUI_Minimal, without its license page. -->
    <UI Id="EFBBrowserUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="1"
               Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2"
               Condition="Installed" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
    </UI>
    <UIRef Id="WixUI_Common" />
    <WixVariable Id="WixUIDialogBmp" Value="$(sys.SOURCEFILEDIR)WixUIDialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)WixUIBanner.bmp" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="Start Microsoft Flight Simulator 2024, open the EFB tablet and launch the Browser app. The companion starts and stops with the sim." />

    <Icon Id="app.ico" SourceFile="$(sys.SOURCEFILEDIR)..\companion\assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="app.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://butr.cc" />
    <Property Id="ARPHELPLINK" Value="https://github.com/emergencybutter/butter-efb-browser/issues" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/emergencybutter/butter-efb-browser/releases" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- Must match install::install_dir() so that the install step finds itself already in place. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="EFB Browser Companion" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main">
      <Component Id="Companion" Directory="INSTALLFOLDER" Guid="8B2E4F61-0C3D-4A7E-B5D9-2F6A1C8E3B47">
        <!-- Per-user components need an HKCU key path (ICE38) and must remove their folders (ICE64). -->
        <RegistryValue Root="HKCU" Key="Software\ButterSim\EFB Browser Companion" Name="Installed"
                       Type="integer" Value="1" KeyPath="yes" />
        <File Id="CompanionExe" Source="$(sys.SOURCEFILEDIR)..\companion\target\release\efb-browser-companion.exe" />
        <Shortcut Id="StartMenu" Directory="ProgramMenuFolder" Name="EFB Browser Companion"
                  Target="[#CompanionExe]" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      </Component>
    </Feature>

    <!-- A running companion locks the exe: it has no window, so terminate it (its Edge goes with it). -->
    <util:CloseApplication Id="CloseCompanion" Target="efb-browser-companion.exe"
                           CloseMessage="no" TerminateProcess="0" RebootPrompt="no" />

    <!-- The sim only loads Community packages when it starts, and holds their files open: ask to quit it
         first (Abort / Retry / Ignore; the install step itself refuses to run while the sim is up). -->
    <util:CloseApplication Id="CloseSim" Target="FlightSimulator2024.exe" PromptToContinue="yes"
                           Description="Microsoft Flight Simulator 2024 is running. Quit the sim, then click Retry."
                           CloseMessage="no" EndSessionMessage="no" RebootPrompt="no" />

    <!-- replace-inno: take over an install made by the earlier Inno Setup installer (same folder).
         error-dialog: show why it failed (Windows Installer only reports error 1722); not when silent. -->
    <CustomAction Id="RunInstall" FileRef="CompanionExe" ExeCommand="--install --replace-inno --error-dialog"
                  Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="RunInstallSilent" FileRef="CompanionExe" ExeCommand="--install --replace-inno --no-elevate"
                  Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="RunUninstall" FileRef="CompanionExe" ExeCommand="--uninstall"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RunInstall" After="InstallFiles" Condition="NOT REMOVE~=&quot;ALL&quot; AND UILevel &gt; 2" />
      <Custom Action="RunInstallSilent" After="RunInstall" Condition="NOT REMOVE~=&quot;ALL&quot; AND UILevel &lt;= 2" />
      <Custom Action="RunUninstall" Before="RemoveFiles"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
